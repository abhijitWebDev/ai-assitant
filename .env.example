# Copy to .env.local and fill in. Never commit .env.local.

# ---- Language model (pick one provider) ----
LLM_PROVIDER=openai            # openai | anthropic | google | groq
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=

# Optional: override the models. "Smart" runs the manager, planner, coverage,
# synthesis, critic and citation checker; "fast" runs guardrail, queries, scoring.
# SMART_MODEL=gpt-4.1
# FAST_MODEL=gpt-4.1-mini
# LLM_TEMPERATURE=0.2

# ---- Web search (tried in this order; providers without a key are skipped) ----
TAVILY_API_KEY=
# SERPAPI_API_KEY=
# BRAVE_API_KEY=
# SEARCH_PROVIDERS=tavily,serpapi,brave,duckduckgo
# SEARCH_RESULTS_PER_QUERY=5
# SEARCH_TIMEOUT_MS=15000

# ---- APIs / MCP channel ----
# API_SOURCES=wikipedia,arxiv     # set empty to disable
# MCP_SERVER_URL=http://localhost:8000/mcp   # any Streamable HTTP MCP server
# MCP_TOOL_NAME=search
# MCP_QUERY_ARG=query

# ---- Loop limits and evidence store ----
# MAX_RESEARCH_ITERATIONS=2   # extra research passes the coverage evaluator may request
# MAX_REVISIONS=2             # times the critic can send a draft back
# MAX_SUB_QUESTIONS=5
# MIN_RELEVANCE=6             # 0-10; evidence below this never enters the store
# MAX_EVIDENCE=40             # store size cap; lowest scores are evicted
# LLM_CONCURRENCY=4

# ---- Observability (LangSmith picks these up automatically) ----
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=research-agent

# ---- Storage ----
# DATA_DIR=./data

# ---- Semantic memory: self-hosted LanceDB service (optional) ----
# Unset = BM25 keyword search only. Set all three to add vector search over uploads
# and prior reports. Embeddings use OPENAI_API_KEY whatever LLM_PROVIDER is.
# LANCEDB_URI=https://lancedb.example.com
# LANCEDB_API_KEY=
# LANCEDB_AGENT_RESEARCH=research-agent   # table name prefix
# INDEX_VERSION=v1                        # bump to index into fresh tables
# EMBEDDING_MODEL=text-embedding-3-small
# VECTOR_MAX_DISTANCE=1.3
# After first setup, index existing data with: npm run index:vectors

# ---- Sign-in (Clerk) ----
# From dashboard.clerk.com > your app > API keys. Without them, `next dev` runs Clerk in
# keyless mode with a temporary dev instance; production needs both.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_...
# CLERK_SECRET_KEY=sk_...
