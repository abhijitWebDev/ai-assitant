   "text": "const append = (a, b) => a.concat(b);\nconst last = (fallback) =>\n  ({ reducer: (_, b) => b, default: () => fallback });\n\nexport const ResearchState = Annotation.Root({\n  question:          Annotation<string>(last(\"\")),\n  researchBrief:     Annotation<string>(last(\"\")),\n  messages:          Annotation<LogEntry[]>(\n                       { reducer: append, default: () => [] }),\n  researchQuestions: Annotation<string[]>(last([])),\n  pendingQueries:    Annotation<PlannedQuery[]>(last([])),\n  rawResults:        Annotation<RawResult[]>(last([])),\n  queryHistory:      Annotation<string[]>(\n                       { reducer: append, default: () => [] }),\n  evidenceStore:     Annotation<EvidenceChunk[]>(\n                       { reducer: mergeEvidence, default: () => [] }),\n  coverageStatus:    Annotation<\"missing\"|\"sufficient\"|\"\">(last(\"\")),\n  iterationCount:    Annotation<number>(last(0)),\n  draftReport:       Annotation<string>(last(\"\")),\n  revisionCount:     Annotation<number>(last(0)),\n  finalReport:       Annotation<string>(last(\"\")),\n  limitations:       Annotation<string[]>({ reducer: append, ... }),\n  errors:            Annotation<ToolError[]>({ reducer: append, ... }),\n});",
   "originalText": "const append = (a, b) => a.concat(b);\nconst last = (fallback) =>\n  ({ reducer: (_, b) => b, default: () => fallback });\n\nexport const ResearchState = Annotation.Root({\n  question:          Annotation<string>(last(\"\")),\n  researchBrief:     Annotation<string>(last(\"\")),\n  messages:          Annotation<LogEntry[]>(\n                       { reducer: append, default: () => [] }),\n  researchQuestions: Annotation<string[]>(last([])),\n  pendingQueries:    Annotation<PlannedQuery[]>(last([])),\n  rawResults:        Annotation<RawResult[]>(last([])),\n  queryHistory:      Annotation<string[]>(\n                       { reducer: append, default: () => [] }),\n  evidenceStore:     Annotation<EvidenceChunk[]>(\n                       { reducer: mergeEvidence, default: () => [] }),\n  coverageStatus:    Annotation<\"missing\"|\"sufficient\"|\"\">(last(\"\")),\n  iterationCount:    Annotation<number>(last(0)),\n  draftReport:       Annotation<string>(last(\"\")),\n  revisionCount:     Annotation<number>(last(0)),\n  finalReport:       Annotation<string>(last(\"\")),\n  limitations:       Annotation<string[]>({ reducer: append, ... }),\n  errors:            Annotation<ToolError[]>({ reducer: append, ... }),\n});",
