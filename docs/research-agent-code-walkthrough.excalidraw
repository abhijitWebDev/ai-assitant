   "text": "async function withFallback(opts, call) {\n  const main = primary(opts.tier);      // e.g. openai gpt-4.1\n  try {\n    return await call(await getModel(main, opts.kind),\n                      opts.name, opts.user);\n  } catch (err) {\n    const alt = fallback(opts.tier);    // e.g. groq gpt-oss\n    if (!alt || isAbort(err)) throw err;\n    try {\n      let user = opts.user;\n      if (opts.fit && estimateTokens(opts.system, user) + output\n                      > budget.tokensPerMinute) {\n        user = opts.fit(room * CHARS_PER_TOKEN * 0.95);\n      }\n      // wait for room in the fallback's 1-minute window\n      await reserve(`${alt.provider}:${alt.model}`,\n                    estimateTokens(opts.system, user) + output, budget);\n      return await call(await getModel(alt, opts.kind),\n                        `${opts.name} (fallback)`, user);\n    } catch (fallbackErr) {\n      throw err;                // report the MAIN model's error\n    }\n  }\n}",
   "originalText": "async function withFallback(opts, call) {\n  const main = primary(opts.tier);      // e.g. openai gpt-4.1\n  try {\n    return await call(await getModel(main, opts.kind),\n                      opts.name, opts.user);\n  } catch (err) {\n    const alt = fallback(opts.tier);    // e.g. groq gpt-oss\n    if (!alt || isAbort(err)) throw err;\n    try {\n      let user = opts.user;\n      if (opts.fit && estimateTokens(opts.system, user) + output\n                      > budget.tokensPerMinute) {\n        user = opts.fit(room * CHARS_PER_TOKEN * 0.95);\n      }\n      // wait for room in the fallback's 1-minute window\n      await reserve(`${alt.provider}:${alt.model}`,\n                    estimateTokens(opts.system, user) + output, budget);\n      return await call(await getModel(alt, opts.kind),\n                        `${opts.name} (fallback)`, user);\n    } catch (fallbackErr) {\n      throw err;                // report the MAIN model's error\n    }\n  }\n}",
   "fontSize": 15.5,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25,
   "baseline": 13
  },
  {
