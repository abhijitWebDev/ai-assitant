   "locked": false,
   "text": "export async function callStructured<T extends z.ZodTypeAny>(opts: {\n  tier: ModelTier;          // \"smart\" | \"fast\"\n  schema: T;                // zod: the shape of the reply\n  name: string;             // run name in LangSmith traces\n  system: string; user: string;\n  fit?: FitPrompt;          // smaller prompt for the fallback\n}): Promise<z.infer<T>> {\n  const testResponder = g.__researchTestResponder;\n  if (testResponder) return opts.schema.parse(testResponder({...}));\n\n  return withFallback({ ...opts, kind: \"structured\" },\n    async (model, runName, user) => {\n      const messages = [new SystemMessage(opts.system),\n                        new HumanMessage(user)];\n      const runnable = model.withStructuredOutput(opts.schema,\n                                                  { name: opts.name });\n      let lastError;\n      for (let attempt = 0; attempt < 2; attempt++) {\n        try {\n          const out = await runnable.invoke(messages, { runName });\n          return opts.schema.parse(out);     // validate, always\n        } catch (err) { lastError = err; }\n      }\n      throw lastError;\n    });\n}",
   "originalText": "export async function callStructured<T extends z.ZodTypeAny>(opts: {\n  tier: ModelTier;          // \"smart\" | \"fast\"\n  schema: T;                // zod: the shape of the reply\n  name: string;             // run name in LangSmith traces\n  system: string; user: string;\n  fit?: FitPrompt;          // smaller prompt for the fallback\n}): Promise<z.infer<T>> {\n  const testResponder = g.__researchTestResponder;\n  if (testResponder) return opts.schema.parse(testResponder({...}));\n\n  return withFallback({ ...opts, kind: \"structured\" },\n    async (model, runName, user) => {\n      const messages = [new SystemMessage(opts.system),\n                        new HumanMessage(user)];\n      const runnable = model.withStructuredOutput(opts.schema,\n                                                  { name: opts.name });\n      let lastError;\n      for (let attempt = 0; attempt < 2; attempt++) {\n        try {\n          const out = await runnable.invoke(messages, { runName });\n          return opts.schema.parse(out);     // validate, always\n        } catch (err) { lastError = err; }\n      }\n      throw lastError;\n    });\n}",
   "fontSize": 14.5,
   "fontFamily": 3,
   "textAlign": "left",
