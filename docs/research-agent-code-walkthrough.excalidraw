   "text": "export async function* runResearch(opts) {\n  const graph = getGraph();\n  const cfg = { configurable: { thread_id: opts.threadId,\n                                user_id: opts.userId } };\n  yield { type: \"start\", threadId: opts.threadId, ... };\n\n  const stream = await graph.stream({ question: opts.question },\n    { ...cfg, streamMode: \"updates\", signal: opts.signal,\n      recursionLimit: 20 + 4 * (2 + 1) + 2 * (2 + 1) });\n  for await (const chunk of stream)\n    for (const [node, u] of Object.entries(chunk))\n      yield { type: \"node\", node, log: u.messages, snapshot: {...} };\n\n  const state = (await graph.getState(cfg)).values;\n  if (!state.guardrail.allowed) {\n    yield { type: \"blocked\", guardrail: state.guardrail }; return;\n  }\n  const reportId = saveReport({ threadId, question,\n    summary: extractSummary(state.finalReport),\n    report: state.finalReport, evidence: state.evidenceStore, ... });\n  if (vectorEnabled())\n    indexReport({ id: reportId, ... }).catch(console.warn);\n  yield { type: \"done\", reportId, finalReport: state.finalReport, ... };\n}",
   "originalText": "export async function* runResearch(opts) {\n  const graph = getGraph();\n  const cfg = { configurable: { thread_id: opts.threadId,\n                                user_id: opts.userId } };\n  yield { type: \"start\", threadId: opts.threadId, ... };\n\n  const stream = await graph.stream({ question: opts.question },\n    { ...cfg, streamMode: \"updates\", signal: opts.signal,\n      recursionLimit: 20 + 4 * (2 + 1) + 2 * (2 + 1) });\n  for await (const chunk of stream)\n    for (const [node, u] of Object.entries(chunk))\n      yield { type: \"node\", node, log: u.messages, snapshot: {...} };\n\n  const state = (await graph.getState(cfg)).values;\n  if (!state.guardrail.allowed) {\n    yield { type: \"blocked\", guardrail: state.guardrail }; return;\n  }\n  const reportId = saveReport({ threadId, question,\n    summary: extractSummary(state.finalReport),\n    report: state.finalReport, evidence: state.evidenceStore, ... });\n  if (vectorEnabled())\n    indexReport({ id: reportId, ... }).catch(console.warn);\n  yield { type: \"done\", reportId, finalReport: state.finalReport, ... };\n}",
