   "text": "export const maxDuration = 300;\n\nexport async function POST(request: Request) {\n  const user = await requireUser();                  // Clerk\n  if (user instanceof Response) return user;\n  const { question, threadId } = await request.json();\n  const denied = guardThread(threadId, user);        // owner?\n  if (denied) return denied;\n  const release = claimRunSlot(user);                // 1 at a time\n  if (!release) return tooManyRequests(\"...already running\");\n  const limit = takeToken(user, \"research\");         // 10/h, 40/day\n  if (!limit.ok) { release(); return tooManyRequests(...); }\n\n  const stream = new ReadableStream({ async start(controller) {\n    const send = (data) => controller.enqueue(\n      encoder.encode(`data: ${JSON.stringify(data)}\\n\\n`));\n    try {\n      for await (const event of runResearch({ question, threadId,\n          userId: user, signal: request.signal }))\n        send(event);\n    } catch (err) { send({ type: \"error\", message: ... }); }\n    finally { release(); controller.close(); }\n  }});\n  return new Response(stream, { headers: {\n    \"Content-Type\": \"text/event-stream\", \"X-Accel-Buffering\": \"no\" }});\n}",
   "originalText": "export const maxDuration = 300;\n\nexport async function POST(request: Request) {\n  const user = await requireUser();                  // Clerk\n  if (user instanceof Response) return user;\n  const { question, threadId } = await request.json();\n  const denied = guardThread(threadId, user);        // owner?\n  if (denied) return denied;\n  const release = claimRunSlot(user);                // 1 at a time\n  if (!release) return tooManyRequests(\"...already running\");\n  const limit = takeToken(user, \"research\");         // 10/h, 40/day\n  if (!limit.ok) { release(); return tooManyRequests(...); }\n\n  const stream = new ReadableStream({ async start(controller) {\n    const send = (data) => controller.enqueue(\n      encoder.encode(`data: ${JSON.stringify(data)}\\n\\n`));\n    try {\n      for await (const event of runResearch({ question, threadId,\n          userId: user, signal: request.signal }))\n        send(event);\n    } catch (err) { send({ type: \"error\", message: ... }); }\n    finally { release(); controller.close(); }\n  }});\n  return new Response(stream, { headers: {\n    \"Content-Type\": \"text/event-stream\", \"X-Accel-Buffering\": \"no\" }});\n}",
