   "text": "await Promise.all(state.pendingQueries.map(async (q) => {\n  const jobs: Promise<void>[] = [];\n  // 1. Web search with provider fallback chain\n  jobs.push(webSearch(q.webQuery).then(({ provider, hits, failures }) => {\n    for (const f of failures) errors.push({ tool: `web:${f.provider}`, ...});\n    for (const h of hits) rawResults.push({ subQuestion: q.subQuestion,\n        query: q.webQuery, sourceType: \"web\", provider, ...h });\n  }));\n  // 2. Private documents (BM25 + LanceDB over this thread's uploads)\n  if (hasDocs) jobs.push(\n    searchDocs(threadId, `${q.docQuery} ${q.subQuestion}`)\n      .then(({ hits, mode, vectorError }) => { /* sourceType \"doc\" */ })\n      .catch((err) => errors.push({ tool: \"docs\", ... })));\n  // 3. External APIs / MCP (public APIs cached; MCP may be private)\n  for (const adapter of adapters) {\n    const query = () => withTimeout(\n        (signal) => adapter.search(q.apiQuery, signal), 15000);\n    jobs.push((adapter.name === \"mcp\"\n        ? query().then((value) => ({ value, cached: false }))\n        : cachedSearch(\"api\", [adapter.name, q.apiQuery], query))\n      .then(({ value: hits }) => { /* sourceType \"api\" */ })\n      .catch((err) => errors.push({ tool: `api:${adapter.name}` })));\n  }\n  await Promise.all(jobs);\n}));",
   "originalText": "await Promise.all(state.pendingQueries.map(async (q) => {\n  const jobs: Promise<void>[] = [];\n  // 1. Web search with provider fallback chain\n  jobs.push(webSearch(q.webQuery).then(({ provider, hits, failures }) => {\n    for (const f of failures) errors.push({ tool: `web:${f.provider}`, ...});\n    for (const h of hits) rawResults.push({ subQuestion: q.subQuestion,\n        query: q.webQuery, sourceType: \"web\", provider, ...h });\n  }));\n  // 2. Private documents (BM25 + LanceDB over this thread's uploads)\n  if (hasDocs) jobs.push(\n    searchDocs(threadId, `${q.docQuery} ${q.subQuestion}`)\n      .then(({ hits, mode, vectorError }) => { /* sourceType \"doc\" */ })\n      .catch((err) => errors.push({ tool: \"docs\", ... })));\n  // 3. External APIs / MCP (public APIs cached; MCP may be private)\n  for (const adapter of adapters) {\n    const query = () => withTimeout(\n        (signal) => adapter.search(q.apiQuery, signal), 15000);\n    jobs.push((adapter.name === \"mcp\"\n        ? query().then((value) => ({ value, cached: false }))\n        : cachedSearch(\"api\", [adapter.name, q.apiQuery], query))\n      .then(({ value: hits }) => { /* sourceType \"api\" */ })\n      .catch((err) => errors.push({ tool: `api:${adapter.name}` })));\n  }\n  await Promise.all(jobs);\n}));",
