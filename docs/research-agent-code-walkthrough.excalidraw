   "text": "export function numberedEvidence(evidence, maxChars = Infinity) {\n  return evidence.map((e, i) =>\n    `[${i + 1}] ${e.title} — ${e.url}\n(sub-question: ${e.subQuestion})\n${truncate(e.content, maxChars)}`).join(\"\\n\\n\");\n}\n\nconst SYSTEM = `You are a senior research analyst writing a report\nstrictly from the evidence provided.\nRules:\n- Every factual sentence must end with one or more citations\n  like [3] or [2][5], using the evidence numbers given.\n- Use ONLY facts present in the evidence. If evidence for\n  something is missing, say so plainly instead of filling the gap.\n- Where sources disagree, say so and cite both.\nOutput Markdown with exactly this structure:\n# <A specific title>\n## Summary\n## Key Findings\n### <Theme 1> ...\nDo NOT write a Sources or References section;\nit is generated automatically.`;",
   "originalText": "export function numberedEvidence(evidence, maxChars = Infinity) {\n  return evidence.map((e, i) =>\n    `[${i + 1}] ${e.title} — ${e.url}\n(sub-question: ${e.subQuestion})\n${truncate(e.content, maxChars)}`).join(\"\\n\\n\");\n}\n\nconst SYSTEM = `You are a senior research analyst writing a report\nstrictly from the evidence provided.\nRules:\n- Every factual sentence must end with one or more citations\n  like [3] or [2][5], using the evidence numbers given.\n- Use ONLY facts present in the evidence. If evidence for\n  something is missing, say so plainly instead of filling the gap.\n- Where sources disagree, say so and cite both.\nOutput Markdown with exactly this structure:\n# <A specific title>\n## Summary\n## Key Findings\n### <Theme 1> ...\nDo NOT write a Sources or References section;\nit is generated automatically.`;",
   "fontSize": 16,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25,
   "baseline": 14
  },
  {
   "id": "x10_0",
