   "link": null,
   "locked": false,
   "text": "export async function webSearch(query: string) {\n  const failures = [];\n  for (const name of config.search.providers) {\n    // [\"tavily\", \"serpapi\", \"brave\", \"duckduckgo\"]\n    const p = REGISTRY[name];\n    if (!p || !p.available()) continue;     // no API key: skip\n    const controller = new AbortController();\n    const timer = setTimeout(() => controller.abort(), 15000);\n    try {\n      const n = config.search.resultsPerQuery;          // 5\n      const { value: hits, cached } = await cachedSearch(\"web\",\n        [p.name, n, normalizeQuery(query)],\n        async () => (await p.search(query, n, controller.signal))\n                      .filter((h) => h.url && h.content));\n      if (hits.length) return { provider: p.name, hits, cached, failures };\n      failures.push({ provider: p.name, error: \"no results\" });\n    } catch (err) {\n      failures.push({ provider: p.name, error: err.message });\n    } finally {\n      clearTimeout(timer);\n    }\n  }\n  return { provider: null, hits: [], cached: false, failures };\n}",
   "originalText": "export async function webSearch(query: string) {\n  const failures = [];\n  for (const name of config.search.providers) {\n    // [\"tavily\", \"serpapi\", \"brave\", \"duckduckgo\"]\n    const p = REGISTRY[name];\n    if (!p || !p.available()) continue;     // no API key: skip\n    const controller = new AbortController();\n    const timer = setTimeout(() => controller.abort(), 15000);\n    try {\n      const n = config.search.resultsPerQuery;          // 5\n      const { value: hits, cached } = await cachedSearch(\"web\",\n        [p.name, n, normalizeQuery(query)],\n        async () => (await p.search(query, n, controller.signal))\n                      .filter((h) => h.url && h.content));\n      if (hits.length) return { provider: p.name, hits, cached, failures };\n      failures.push({ provider: p.name, error: \"no results\" });\n    } catch (err) {\n      failures.push({ provider: p.name, error: err.message });\n    } finally {\n      clearTimeout(timer);\n    }\n  }\n  return { provider: null, hits: [], cached: false, failures };\n}",
   "fontSize": 15.0,
   "fontFamily": 3,
