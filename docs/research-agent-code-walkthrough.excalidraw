   "link": null,
   "locked": false,
   "text": "const Queries = z.object({ queries: z.array(z.object({\n  subQuestion: z.string(),\n  webQuery: z.string().describe(\"Keyword-dense web search query:\"\n    + \" key entities, technical terms, years. No question words.\"),\n  docQuery: z.string().describe(\"Distinctive keywords likely to\"\n    + \" appear verbatim inside a private document\"),\n  apiQuery: z.string().describe(\"2-5 word topic phrase for\"\n    + \" encyclopedia / academic-paper search\"),\n}))});\n\nconst isLoop = state.coverageStatus === \"missing\";\nconst already = state.queryHistory.slice(-30);\nconst user = isLoop\n  ? `The coverage evaluator found these gaps:\n${state.gapAnalysis}\nQueries already tried (do not repeat or lightly reword them):\n${already.map((q) => `- ${q}`).join(\"\\n\")}\nWrite 1-4 NEW queries that target only the gaps.`\n  : `Already known from prior research: ${state.priorContext}\nSub-questions: ...\nWrite exactly one query set per sub-question.`;",
   "originalText": "const Queries = z.object({ queries: z.array(z.object({\n  subQuestion: z.string(),\n  webQuery: z.string().describe(\"Keyword-dense web search query:\"\n    + \" key entities, technical terms, years. No question words.\"),\n  docQuery: z.string().describe(\"Distinctive keywords likely to\"\n    + \" appear verbatim inside a private document\"),\n  apiQuery: z.string().describe(\"2-5 word topic phrase for\"\n    + \" encyclopedia / academic-paper search\"),\n}))});\n\nconst isLoop = state.coverageStatus === \"missing\";\nconst already = state.queryHistory.slice(-30);\nconst user = isLoop\n  ? `The coverage evaluator found these gaps:\n${state.gapAnalysis}\nQueries already tried (do not repeat or lightly reword them):\n${already.map((q) => `- ${q}`).join(\"\\n\")}\nWrite 1-4 NEW queries that target only the gaps.`\n  : `Already known from prior research: ${state.priorContext}\nSub-questions: ...\nWrite exactly one query set per sub-question.`;",
   "fontSize": 16,
