   "text": "export async function inputGuardrail(state) {\n  const quick = heuristicCheck(state.question);\n  if (quick) return { guardrail: quick, messages: [...] };\n  try {\n    const v = await callStructured({\n      tier: \"fast\", schema: Verdict, name: \"input_guardrail\",\n      system: SYSTEM,\n      user: `User input:\\n\"\"\"${state.question}\"\"\"`,\n    });\n    const allowed = v.category === \"valid\";\n    const result = allowed\n      ? { allowed, category: \"valid\", message: \"\" }\n      : { allowed, category: v.category,\n          message: `${MESSAGES[v.category]} ${v.suggestion}` };\n    return { guardrail: result, messages: [...] };\n  } catch (err) {\n    // Fail open: the guardrail must never be the reason\n    // a valid question can't run.\n    return { guardrail: { allowed: true, category: \"valid\" },\n             errors: [{ node: \"input_guardrail\", tool: \"llm\", ... }] };\n  }\n}\nexport function routeAfterGuardrail(state) {\n  return state.guardrail?.allowed ? \"research_manager\" : \"__end__\";\n}",
   "originalText": "export async function inputGuardrail(state) {\n  const quick = heuristicCheck(state.question);\n  if (quick) return { guardrail: quick, messages: [...] };\n  try {\n    const v = await callStructured({\n      tier: \"fast\", schema: Verdict, name: \"input_guardrail\",\n      system: SYSTEM,\n      user: `User input:\\n\"\"\"${state.question}\"\"\"`,\n    });\n    const allowed = v.category === \"valid\";\n    const result = allowed\n      ? { allowed, category: \"valid\", message: \"\" }\n      : { allowed, category: v.category,\n          message: `${MESSAGES[v.category]} ${v.suggestion}` };\n    return { guardrail: result, messages: [...] };\n  } catch (err) {\n    // Fail open: the guardrail must never be the reason\n    // a valid question can't run.\n    return { guardrail: { allowed: true, category: \"valid\" },\n             errors: [{ node: \"input_guardrail\", tool: \"llm\", ... }] };\n  }\n}\nexport function routeAfterGuardrail(state) {\n  return state.guardrail?.allowed ? \"research_manager\" : \"__end__\";\n}",
