   "text": "const revising = state.critique?.verdict === \"revision_needed\"\n                 && Boolean(state.draftReport);\nconst build = (cap, withDraft = true) => `Research question: ...\nBrief: ${state.researchBrief}\nSub-questions to address: ...\nEvidence (${evidence.length} chunks): ${numberedEvidence(evidence, cap)}\n${revising ? `Reviewer's brief: ${state.critique.brief}\nPrevious draft: ${state.draftReport}\nRewrite the full report, fixing every issue in the brief.` : \"\"}`;\n\ntry {\n  let draft = await callText({ tier: \"smart\",\n    name: revising ? \"synthesis_revision\" : \"synthesis\",\n    system: SYSTEM, user: build(Infinity), fit });\n  draft = draft\n    .replace(/^```(?:markdown)?\\s*/i, \"\")          // code fences\n    .replace(/```\\s*$/, \"\")\n    .replace(/\\n#{1,3}\\s*(Sources|References)\\b[\\s\\S]*$/i, \"\")\n    .trim();\n  return { draftReport: draft, messages: [...] };\n} catch (err) {\n  return { draftReport: state.draftReport || \"# ...could not be generated\",\n           limitations: [\"Report generation failed...\"] };\n}",
   "originalText": "const revising = state.critique?.verdict === \"revision_needed\"\n                 && Boolean(state.draftReport);\nconst build = (cap, withDraft = true) => `Research question: ...\nBrief: ${state.researchBrief}\nSub-questions to address: ...\nEvidence (${evidence.length} chunks): ${numberedEvidence(evidence, cap)}\n${revising ? `Reviewer's brief: ${state.critique.brief}\nPrevious draft: ${state.draftReport}\nRewrite the full report, fixing every issue in the brief.` : \"\"}`;\n\ntry {\n  let draft = await callText({ tier: \"smart\",\n    name: revising ? \"synthesis_revision\" : \"synthesis\",\n    system: SYSTEM, user: build(Infinity), fit });\n  draft = draft\n    .replace(/^```(?:markdown)?\\s*/i, \"\")          // code fences\n    .replace(/```\\s*$/, \"\")\n    .replace(/\\n#{1,3}\\s*(Sources|References)\\b[\\s\\S]*$/i, \"\")\n    .trim();\n  return { draftReport: draft, messages: [...] };\n} catch (err) {\n  return { draftReport: state.draftReport || \"# ...could not be generated\",\n           limitations: [\"Report generation failed...\"] };\n}",
   "fontSize": 15.0,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
