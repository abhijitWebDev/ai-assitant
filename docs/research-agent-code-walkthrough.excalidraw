   "text": "const CITE = /\\[(\\d+(?:\\s*,\\s*\\d+)*)\\]/g;   // [3] or [2, 5]\n\nfunction cleanCitations(report: string, max: number) {\n  const invalid = new Set<number>(), cited = new Set<number>();\n  const text = report.replace(CITE, (_m, nums: string) => {\n    const kept = nums.split(\",\").map((n) => Number(n.trim()))\n      .filter((n) => {\n        const ok = n >= 1 && n <= max;      // max = evidence.length\n        if (ok) cited.add(n); else invalid.add(n);\n        return ok;\n      });\n    return kept.map((n) => `[${n}]`).join(\"\");\n  });\n  return { text, invalid: [...invalid], cited: [...cited].sort() };\n}\n\nexport function buildSources(evidence, cited: number[]) {\n  if (!cited.length) return \"## Sources\\n\\n_No sources were cited._\";\n  const lines = cited.map((n) => {\n    const e = evidence[n - 1];\n    return `**[${n}]** ${sourceLabel(e)}\n_Found via ${e.provider}, retrieved ${e.retrievedAt.slice(0, 10)}_\n> ${truncate(e.content, 280)}`;\n  });\n  return `## Sources\\n\\n${lines.join(\"\\n\\n\")}`;\n}",
   "originalText": "const CITE = /\\[(\\d+(?:\\s*,\\s*\\d+)*)\\]/g;   // [3] or [2, 5]\n\nfunction cleanCitations(report: string, max: number) {\n  const invalid = new Set<number>(), cited = new Set<number>();\n  const text = report.replace(CITE, (_m, nums: string) => {\n    const kept = nums.split(\",\").map((n) => Number(n.trim()))\n      .filter((n) => {\n        const ok = n >= 1 && n <= max;      // max = evidence.length\n        if (ok) cited.add(n); else invalid.add(n);\n        return ok;\n      });\n    return kept.map((n) => `[${n}]`).join(\"\");\n  });\n  return { text, invalid: [...invalid], cited: [...cited].sort() };\n}\n\nexport function buildSources(evidence, cited: number[]) {\n  if (!cited.length) return \"## Sources\\n\\n_No sources were cited._\";\n  const lines = cited.map((n) => {\n    const e = evidence[n - 1];\n    return `**[${n}]** ${sourceLabel(e)}\n_Found via ${e.provider}, retrieved ${e.retrievedAt.slice(0, 10)}_\n> ${truncate(e.content, 280)}`;\n  });\n  return `## Sources\\n\\n${lines.join(\"\\n\\n\")}`;\n}",
