   "link": null,
   "locked": false,
   "text": "const Brief = z.object({\n  objective: z.string(), scope: z.string(), audience: z.string(),\n});\n\nexport async function researchManager(state) {\n  let researchBrief = `Objective: ${state.question}`;\n  try {\n    const b = await callStructured({ tier: \"smart\", schema: Brief,\n      name: \"research_manager\",\n      system: \"...Interpret the user's research question precisely:\"\n            + \" the real objective, a sensible scope, and the\"\n            + \" audience. Do not answer the question.\",\n      user: `Research question: ${state.question}` });\n    researchBrief = `Objective: ${b.objective}\\nScope: ...`;\n  } catch (err) { errors.push({ node: \"research_manager\", ... }); }\n\n  return {\n    researchBrief,\n    // Reset everything that belongs to a single run.\n    messages: new Overwrite([log(\"research_manager\", ...)]),\n    evidenceStore: new Overwrite([]),\n    queryHistory: new Overwrite([]),\n    limitations: new Overwrite([]),\n    researchQuestions: [], iterationCount: 0, revisionCount: 0,\n    draftReport: \"\", finalReport: \"\", ...\n  };\n}",
   "originalText": "const Brief = z.object({\n  objective: z.string(), scope: z.string(), audience: z.string(),\n});\n\nexport async function researchManager(state) {\n  let researchBrief = `Objective: ${state.question}`;\n  try {\n    const b = await callStructured({ tier: \"smart\", schema: Brief,\n      name: \"research_manager\",\n      system: \"...Interpret the user's research question precisely:\"\n            + \" the real objective, a sensible scope, and the\"\n            + \" audience. Do not answer the question.\",\n      user: `Research question: ${state.question}` });\n    researchBrief = `Objective: ${b.objective}\\nScope: ...`;\n  } catch (err) { errors.push({ node: \"research_manager\", ... }); }\n\n  return {\n    researchBrief,\n    // Reset everything that belongs to a single run.\n    messages: new Overwrite([log(\"research_manager\", ...)]),\n    evidenceStore: new Overwrite([]),\n    queryHistory: new Overwrite([]),\n    limitations: new Overwrite([]),\n    researchQuestions: [], iterationCount: 0, revisionCount: 0,\n    draftReport: \"\", finalReport: \"\", ...\n  };\n}",
