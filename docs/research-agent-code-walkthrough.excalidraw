   "updated": 1,
   "link": null,
   "locked": false,
   "text": "const Scored = z.object({ items: z.array(z.object({\n  index: z.number().int(),          // the [n] of the result\n  score: z.number().min(0).max(10)\n    .describe(\"0 = unrelated, 10 = directly answers it\"),\n  passage: z.string().describe(\"The relevant facts, kept close\"\n    + \" to the original wording, max ~120 words.\"\n    + \" Empty if irrelevant.\"),\n}))});\n\nfunction shingles(text: string, n = 3): Set<string> {\n  const t = tokenize(text);       // lowercase, no stopwords\n  const out = new Set<string>();\n  for (let i = 0; i + n <= t.length; i++)\n    out.add(t.slice(i, i + n).join(\" \"));\n  return out;\n}\n\n// Jaccard on word 3-grams; > 0.6 = \"same passage, other source\"\nexport function similarity(a: string, b: string): number {\n  const A = shingles(a), B = shingles(b);\n  let inter = 0;\n  for (const s of A) if (B.has(s)) inter++;\n  return inter / (A.size + B.size - inter);\n}",
   "originalText": "const Scored = z.object({ items: z.array(z.object({\n  index: z.number().int(),          // the [n] of the result\n  score: z.number().min(0).max(10)\n    .describe(\"0 = unrelated, 10 = directly answers it\"),\n  passage: z.string().describe(\"The relevant facts, kept close\"\n    + \" to the original wording, max ~120 words.\"\n    + \" Empty if irrelevant.\"),\n}))});\n\nfunction shingles(text: string, n = 3): Set<string> {\n  const t = tokenize(text);       // lowercase, no stopwords\n  const out = new Set<string>();\n  for (let i = 0; i + n <= t.length; i++)\n    out.add(t.slice(i, i + n).join(\" \"));\n  return out;\n}\n\n// Jaccard on word 3-grams; > 0.6 = \"same passage, other source\"\nexport function similarity(a: string, b: string): number {\n  const A = shingles(a), B = shingles(b);\n  let inter = 0;\n  for (const s of A) if (B.has(s)) inter++;\n  return inter / (A.size + B.size - inter);\n}",
