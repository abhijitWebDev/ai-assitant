   "text": "let body = state.draftReport;\nif (evidence.length) {\n  try {\n    const c = await callStructured({ tier: \"smart\", schema: Check,\n      name: \"citation_checker\",\n      system: \"You are a citation auditor. ... For each factual\"\n            + \" claim, find the evidence entry that supports it.\"\n            + \" Do not rewrite style; only fix citations.\",\n      user: `Evidence: ${numberedEvidence(evidence)} Report: ${body}` });\n    unsupported = c.unsupported;\n    for (const edit of c.edits) {\n      if (edit.original && body.includes(edit.original)) {\n        body = body.replace(edit.original, edit.replacement);\n        applied++;\n      }\n    }\n  } catch (err) { limitations.push(\"...audit failed; only\"\n                   + \" citation numbers were validated.\"); }\n}\nconst { text, invalid, cited } = cleanCitations(body, evidence.length);\nconst finalReport = [text, buildSources(evidence, cited),\n  notes.length ? `## Research notes\\n\\n${notes}` : \"\"]\n  .filter(Boolean).join(\"\\n\\n\");",
   "originalText": "let body = state.draftReport;\nif (evidence.length) {\n  try {\n    const c = await callStructured({ tier: \"smart\", schema: Check,\n      name: \"citation_checker\",\n      system: \"You are a citation auditor. ... For each factual\"\n            + \" claim, find the evidence entry that supports it.\"\n            + \" Do not rewrite style; only fix citations.\",\n      user: `Evidence: ${numberedEvidence(evidence)} Report: ${body}` });\n    unsupported = c.unsupported;\n    for (const edit of c.edits) {\n      if (edit.original && body.includes(edit.original)) {\n        body = body.replace(edit.original, edit.replacement);\n        applied++;\n      }\n    }\n  } catch (err) { limitations.push(\"...audit failed; only\"\n                   + \" citation numbers were validated.\"); }\n}\nconst { text, invalid, cited } = cleanCitations(body, evidence.length);\nconst finalReport = [text, buildSources(evidence, cited),\n  notes.length ? `## Research notes\\n\\n${notes}` : \"\"]\n  .filter(Boolean).join(\"\\n\\n\");",
