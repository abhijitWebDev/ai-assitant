   "text": "// Group by sub-question, drop exact URL repeats in each group.\nconst groups = new Map<string, RawResult[]>();\nfor (const r of state.rawResults) { /* ... */ }\n\nconst perGroup = await mapLimit([...groups.entries()],\n  config.limits.llmConcurrency,              // 4 at a time\n  async ([subQuestion, results]) => {\n    try {\n      const out = await callStructured({ tier: \"fast\",\n        schema: Scored, name: \"evidence_extractor\",\n        system: \"...pull out only the facts relevant to the\"\n              + \" sub-question and score relevance strictly.\"\n              + \" Never add facts that are not in the result.\",\n        user: prompt(1500),           // 1,500 chars per result\n        fit: (max) => shrinkToFit(prompt, max, 1500, 200) });\n      return out.items\n        .filter((it) => it.index >= 1 && it.index <= results.length\n                        && it.passage.trim())\n        .map((it) => ({ id: randomUUID(), subQuestion,\n           content: it.passage.trim(), score: it.score,\n           ...results[it.index - 1] /* title, url, provider */ }));\n    } catch (err) {\n      // Degrade gracefully: raw content at the threshold score.\n      return results.map((r) => ({ ..., content: truncate(r.content, 800),\n                                   score: config.limits.minRelevance }));\n    }\n  });\nreturn { evidenceStore: perGroup.flat(), errors, messages: [...] };",
   "originalText": "// Group by sub-question, drop exact URL repeats in each group.\nconst groups = new Map<string, RawResult[]>();\nfor (const r of state.rawResults) { /* ... */ }\n\nconst perGroup = await mapLimit([...groups.entries()],\n  config.limits.llmConcurrency,              // 4 at a time\n  async ([subQuestion, results]) => {\n    try {\n      const out = await callStructured({ tier: \"fast\",\n        schema: Scored, name: \"evidence_extractor\",\n        system: \"...pull out only the facts relevant to the\"\n              + \" sub-question and score relevance strictly.\"\n              + \" Never add facts that are not in the result.\",\n        user: prompt(1500),           // 1,500 chars per result\n        fit: (max) => shrinkToFit(prompt, max, 1500, 200) });\n      return out.items\n        .filter((it) => it.index >= 1 && it.index <= results.length\n                        && it.passage.trim())\n        .map((it) => ({ id: randomUUID(), subQuestion,\n           content: it.passage.trim(), score: it.score,\n           ...results[it.index - 1] /* title, url, provider */ }));\n    } catch (err) {\n      // Degrade gracefully: raw content at the threshold score.\n      return results.map((r) => ({ ..., content: truncate(r.content, 800),\n                                   score: config.limits.minRelevance }));\n    }\n  });\nreturn { evidenceStore: perGroup.flat(), errors, messages: [...] };",
