   "updated": 1,
   "link": null,
   "locked": false,
   "text": "const Review = z.object({\n  coherence:    z.number().int().min(1).max(5),\n  grounding:    z.number().int().min(1).max(5),   // claims backed?\n  completeness: z.number().int().min(1).max(5),   // all sub-qs?\n  issues: z.array(z.string()), brief: z.string(),\n});\nconst PASS = 4;\n\nexport async function critic(state) {\n  if (state.revisionCount >= config.limits.maxRevisions) {      // 2\n    return { critique: { verdict: \"approved\", forced: true, ... },\n      limitations: [\"The critic's revision limit (2) was reached;\n                     the last draft was accepted as-is.\"] };\n  }\n  try {\n    const r = await callStructured({ tier: \"smart\", schema: Review,\n      name: \"critic\", system: `You are a demanding research editor.\nScore ${PASS}+ only if the draft is genuinely good on that dimension.\nGrounding: check citations point to evidence that actually supports\nthe sentence. Flag any claim not found in the evidence.`,\n      user: `Evidence: ${numberedEvidence(state.evidenceStore)}\n             Draft: ${state.draftReport}` });\n    const approved = r.coherence >= PASS && r.grounding >= PASS\n                  && r.completeness >= PASS;\n    return { critique: { verdict: approved ? \"approved\"\n                                           : \"revision_needed\", ... },\n             revisionCount: approved ? state.revisionCount\n                                     : state.revisionCount + 1 };\n  } catch (err) { /* forward the draft: \"not self-reviewed\" */ }\n}\nexport function routeAfterCritic(state) {\n  return state.critique?.verdict === \"revision_needed\"\n    ? \"synthesis\" : \"citation_checker\";\n}",
   "originalText": "const Review = z.object({\n  coherence:    z.number().int().min(1).max(5),\n  grounding:    z.number().int().min(1).max(5),   // claims backed?\n  completeness: z.number().int().min(1).max(5),   // all sub-qs?\n  issues: z.array(z.string()), brief: z.string(),\n});\nconst PASS = 4;\n\nexport async function critic(state) {\n  if (state.revisionCount >= config.limits.maxRevisions) {      // 2\n    return { critique: { verdict: \"approved\", forced: true, ... },\n      limitations: [\"The critic's revision limit (2) was reached;\n                     the last draft was accepted as-is.\"] };\n  }\n  try {\n    const r = await callStructured({ tier: \"smart\", schema: Review,\n      name: \"critic\", system: `You are a demanding research editor.\nScore ${PASS}+ only if the draft is genuinely good on that dimension.\nGrounding: check citations point to evidence that actually supports\nthe sentence. Flag any claim not found in the evidence.`,\n      user: `Evidence: ${numberedEvidence(state.evidenceStore)}\n             Draft: ${state.draftReport}` });\n    const approved = r.coherence >= PASS && r.grounding >= PASS\n                  && r.completeness >= PASS;\n    return { critique: { verdict: approved ? \"approved\"\n                                           : \"revision_needed\", ... },\n             revisionCount: approved ? state.revisionCount\n                                     : state.revisionCount + 1 };\n  } catch (err) { /* forward the draft: \"not self-reviewed\" */ }\n}\nexport function routeAfterCritic(state) {\n  return state.critique?.verdict === \"revision_needed\"\n    ? \"synthesis\" : \"citation_checker\";\n}",
