   "text": "export function mergeEvidence(existing, incoming) {\n  const store = [...existing];\n  for (const chunk of incoming) {\n    if (chunk.score < config.limits.minRelevance) continue; // < 6\n    const dupIndex = store.findIndex(\n      (e) => (e.url === chunk.url && e.content === chunk.content)\n          || similarity(e.content, chunk.content) > 0.6,\n    );\n    if (dupIndex >= 0) {\n      if (chunk.score > store[dupIndex].score)\n        store[dupIndex] = chunk;           // keep the better one\n      continue;\n    }\n    store.push(chunk);\n  }\n  if (store.length <= config.limits.maxEvidence) return store; // 40\n  // Evict lowest scores, keep original order for survivors.\n  const keep = new Set([...store]\n      .sort((a, b) => b.score - a.score)\n      .slice(0, config.limits.maxEvidence)\n      .map((e) => e.id));\n  return store.filter((e) => keep.has(e.id));\n}",
   "originalText": "export function mergeEvidence(existing, incoming) {\n  const store = [...existing];\n  for (const chunk of incoming) {\n    if (chunk.score < config.limits.minRelevance) continue; // < 6\n    const dupIndex = store.findIndex(\n      (e) => (e.url === chunk.url && e.content === chunk.content)\n          || similarity(e.content, chunk.content) > 0.6,\n    );\n    if (dupIndex >= 0) {\n      if (chunk.score > store[dupIndex].score)\n        store[dupIndex] = chunk;           // keep the better one\n      continue;\n    }\n    store.push(chunk);\n  }\n  if (store.length <= config.limits.maxEvidence) return store; // 40\n  // Evict lowest scores, keep original order for survivors.\n  const keep = new Set([...store]\n      .sort((a, b) => b.score - a.score)\n      .slice(0, config.limits.maxEvidence)\n      .map((e) => e.id));\n  return store.filter((e) => keep.has(e.id));\n}",
