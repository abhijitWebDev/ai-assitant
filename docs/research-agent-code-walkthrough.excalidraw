   "text": "const chunks = threadChunks(threadId);     // SQLite\nconst n = config.limits.docResultsPerQuery;  // 4\nconst key = (c) => `${c.document_id}:${c.position}`;\n\nconst keyword = bm25Rank(query, chunks.map((c) => c.content))\n  .slice(0, n * 2).map(({ index }) => key(chunks[index]));\n\nlet ranking = keyword, mode = \"bm25\", vectorError;\nif (vectorEnabled()) {\n  try {\n    const semantic = (await searchChunks(threadId, query, n * 2))\n      .map(key).filter((k) => byKey.has(k)); // deleted docs drop out\n    ranking = fuse([keyword, semantic]);\n    mode = \"hybrid\";\n  } catch (err) { vectorError = err.message; }\n}\nconst hits = ranking.slice(0, n).map((k) => {\n  const c = byKey.get(k)!;\n  return { title: `${c.name}, part ${c.position + 1}`,\n           url: `doc://${c.document_id}/${c.position}`,\n           content: c.content };\n});",
   "originalText": "const chunks = threadChunks(threadId);     // SQLite\nconst n = config.limits.docResultsPerQuery;  // 4\nconst key = (c) => `${c.document_id}:${c.position}`;\n\nconst keyword = bm25Rank(query, chunks.map((c) => c.content))\n  .slice(0, n * 2).map(({ index }) => key(chunks[index]));\n\nlet ranking = keyword, mode = \"bm25\", vectorError;\nif (vectorEnabled()) {\n  try {\n    const semantic = (await searchChunks(threadId, query, n * 2))\n      .map(key).filter((k) => byKey.has(k)); // deleted docs drop out\n    ranking = fuse([keyword, semantic]);\n    mode = \"hybrid\";\n  } catch (err) { vectorError = err.message; }\n}\nconst hits = ranking.slice(0, n).map((k) => {\n  const c = byKey.get(k)!;\n  return { title: `${c.name}, part ${c.position + 1}`,\n           url: `doc://${c.document_id}/${c.position}`,\n           content: c.content };\n});",
