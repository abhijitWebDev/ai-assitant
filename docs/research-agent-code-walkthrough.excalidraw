   "text": "try {\n  const out = await callStructured({ tier: \"fast\",\n    schema: Queries, name: \"query_generator\", system, user });\n\n  const seen = new Set(already.map((q) => q.toLowerCase()));\n  const pendingQueries = out.queries.filter(\n    (q) => q.webQuery && !seen.has(q.webQuery.toLowerCase()));\n  if (!pendingQueries.length)\n    throw new Error(\"no new queries generated\");\n\n  return {\n    pendingQueries,                              // replaced\n    queryHistory: pendingQueries.map((q) => q.webQuery), // appended\n    messages: [log(\"query_generator\", ...)],\n  };\n} catch (err) {\n  // Fallback: search the sub-questions directly.\n  const pendingQueries = (isLoop\n      ? [state.gapAnalysis || state.question]\n      : state.researchQuestions\n    ).map((q) => ({ subQuestion: q, webQuery: q, docQuery: q,\n                    apiQuery: q.split(/\\s+/).slice(0, 6).join(\" \") }));\n  return { pendingQueries, queryHistory: ..., errors: [...] };\n}",
   "originalText": "try {\n  const out = await callStructured({ tier: \"fast\",\n    schema: Queries, name: \"query_generator\", system, user });\n\n  const seen = new Set(already.map((q) => q.toLowerCase()));\n  const pendingQueries = out.queries.filter(\n    (q) => q.webQuery && !seen.has(q.webQuery.toLowerCase()));\n  if (!pendingQueries.length)\n    throw new Error(\"no new queries generated\");\n\n  return {\n    pendingQueries,                              // replaced\n    queryHistory: pendingQueries.map((q) => q.webQuery), // appended\n    messages: [log(\"query_generator\", ...)],\n  };\n} catch (err) {\n  // Fallback: search the sub-questions directly.\n  const pendingQueries = (isLoop\n      ? [state.gapAnalysis || state.question]\n      : state.researchQuestions\n    ).map((q) => ({ subQuestion: q, webQuery: q, docQuery: q,\n                    apiQuery: q.split(/\\s+/).slice(0, 6).join(\" \") }));\n  return { pendingQueries, queryHistory: ..., errors: [...] };\n}",
