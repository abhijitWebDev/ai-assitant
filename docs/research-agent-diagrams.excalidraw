   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Every LLM call: callStructured() / callText()\nprimary provider: OpenAI · Anthropic · Google · Groq\nsmart tier for judgement, fast tier for bulk work\n\nfails → fallback provider, once, inside its own\ntokens-per-minute budget; prompt trimmed with fit()\nboth fail → the node's own fallback takes over",
   "originalText": "Every LLM call: callStructured() / callText()\nprimary provider: OpenAI · Anthropic · Google · Groq\nsmart tier for judgement, fast tier for bulk work\n\nfails → fallback provider, once, inside its own\ntokens-per-minute budget; prompt trimmed with fit()\nboth fail → the node's own fallback takes over",
   "fontSize": 18,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "f12_llm",
   "autoResize": true,
