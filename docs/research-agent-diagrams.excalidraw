   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Why fail open here?  (the Medical RAG fails CLOSED)\nCode comment: \"the guardrail must never be the reason a valid question can't run.\"\nIn medicine a wrong answer is the danger, so refusing is safe. Here a wrong refusal just blocks research,\nand every claim still has to pass the Critic and the Citation Checker at the end.",
   "originalText": "Why fail open here?  (the Medical RAG fails CLOSED)\nCode comment: \"the guardrail must never be the reason a valid question can't run.\"\nIn medicine a wrong answer is the danger, so refusing is safe. Here a wrong refusal just blocks research,\nand every claim still has to pass the Critic and the Citation Checker at the end.",
   "fontSize": 20,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "f03_why",
   "autoResize": true,
   "lineHeight": 1.25,
   "baseline": 18
  },
